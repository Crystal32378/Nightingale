# MiniMax Audio — put the real values in .env (gitignored), never here.
# Get both from the MiniMax platform console: https://platform.minimax.io
MINIMAX_API_KEY=
# Not needed by the t2a_v2 endpoint, kept for reference / older endpoints.
MINIMAX_GROUP_ID=

# Nebius Token Factory — the indoor proxy (npm run server) reads this to ask
# Nemotron. Server-side only: never prefix it with VITE_, or Vite bundles it
# into the browser. Leave it empty to run on the mock.
# Create one at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Tavily — the indoor proxy reads Taipei City Hospital's public registration
# pages through Tavily Extract for the clinic lookup. Server-side only, like
# the key above. Leave it empty and the lookup links to the hospital site.
# Create one at https://app.tavily.com
TAVILY_API_KEY=

# Spending limits on the indoor proxy. Empty means the default. Token Factory
# has no spending cap, so these are what bound a public demo's bill.
# Requests per person per minute (default 10, at least 1).
RATE_LIMIT_PER_MINUTE=
# Model calls per Taipei day for everyone together (default 400). 0 stops
# every model call: the kill switch.
DAILY_LIMIT=
