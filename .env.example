# MiniMax Audio — put the real values in .env (gitignored), never here.
# Get both from the MiniMax platform console: https://platform.minimax.io
MINIMAX_API_KEY=
# Not needed by the t2a_v2 endpoint, kept for reference / older endpoints.
MINIMAX_GROUP_ID=

# Nebius Token Factory — the indoor proxy (npm run server) reads this to ask
# Nemotron. Server-side only: never prefix it with VITE_, or Vite bundles it
# into the browser. Leave it empty to run on the mock.
# Create one at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
